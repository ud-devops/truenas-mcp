{
  "mcpServers": {
    "truenas": {
      "command": "/usr/local/bin/truenas-mcp",
      "args": [
        "--truenas-url", "192.168.0.31",
        "--tls-ca", "/etc/ssl/certs/truenas.pem",
        "--read-only"
      ],
      "env": {
        "TRUENAS_API_KEY": "REPLACE_WITH_YOUR_TRUENAS_API_KEY"
      }
    }
  }
}
